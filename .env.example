# MongoDB connection string, including the database name. MongoDB Atlas works as is;
# a self-hosted server must run as a replica set, which Prisma requires.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nuvosid_walkin?retryWrites=true&w=majority"
# Signs login sessions and walkthrough links. Generate: openssl rand -base64 48
AUTH_SECRET=""
# First admin account, created by `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Login for the seeded demo client (Crystal Heights). Random if left empty.
DEMO_PASSCODE=""
# Set to "false" only if production runs on plain http (no SSL yet)
COOKIE_SECURE=""
