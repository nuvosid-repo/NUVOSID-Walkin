# SQLite file, relative to the prisma/ folder
DATABASE_URL="file:./dev.db"
# Signs login sessions and walkthrough links. Generate: openssl rand -base64 48
AUTH_SECRET=""
# First admin account, created by `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Login for the seeded demo client (Crystal Heights). Random if left empty.
DEMO_PASSCODE=""
# Where uploaded 3D models and cover images are stored
STORAGE_DIR="./storage"
# Set to "false" only if production runs on plain http (no SSL yet)
COOKIE_SECURE=""
