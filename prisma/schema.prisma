generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// A builder / developer company. Users and projects belong to one company.
model Company {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  contactPerson String   @default("")
  email         String   @default("")
  phone         String   @default("")
  city          String   @default("")
  address       String   @default("")
  website       String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users    User[]
  projects Project[]
}

model User {
  id             String    @id @default(cuid()) @map("_id")
  username       String    @unique
  name           String
  passcodeHash   String
  /// AES-GCM copy of a client's passcode so admins can view it. Null for admins and for users created before this field existed.
  passcodeSealed String?
  /// "ADMIN" or "CLIENT"
  role           String    @default("CLIENT")
  active         Boolean   @default(true)
  /// Bumped on passcode change or deactivation; invalidates old sessions and viewer links.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Project {
  id            String  @id @default(cuid()) @map("_id")
  name          String
  tagline       String  @default("")
  propertyType  String  @default("Residential")
  status        String  @default("Under construction")
  city          String  @default("")
  address       String  @default("")
  configuration String  @default("")
  area          String  @default("")
  priceRange    String  @default("")
  possession    String  @default("")
  reraNumber    String  @default("")
  totalFloors   String  @default("")
  totalUnits    String  @default("")
  /// Comma separated list
  amenities     String  @default("")
  description   String  @default("")
  /// Whether the company's users can see this project
  published     Boolean @default(true)
  /// File extension of the cover image in storage, empty when there is none
  coverExt      String  @default("")

  /// "html" (pasted or single file) or "zip" (bundle). Null until a model is uploaded.
  modelKind       String?
  /// Path of the entry HTML file inside the model folder
  modelEntry      String?
  /// Changes on every upload; part of viewer links so caches never go stale
  modelVersion    String?
  modelSize       Int       @default(0)
  modelFileCount  Int       @default(0)
  modelUploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cover  ProjectCover?
  chunks ModelChunk[]

  @@index([companyId])
}

/// Cover image bytes. Kept apart from Project so listing projects never loads images.
model ProjectCover {
  id   String @id @default(cuid()) @map("_id")
  data Bytes

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// One piece of one file of a 3D model. Files are split so uploads fit Vercel's request limit.
model ModelChunk {
  id      String @id @default(cuid()) @map("_id")
  /// Matches Project.modelVersion once the upload is finished
  version String
  /// File path inside the model, like "addons/shaders/CopyShader.js"
  path    String
  index   Int
  /// Number of chunks in this file
  total   Int
  size    Int
  data    Bytes

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version, path, index])
}
